{
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/app.css", "dest": "/static/app.css" },
    { "src": "/app.js", "dest": "/static/app.js" },
    { "src": "/screenshots/(.*)", "dest": "/screenshots/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/static/index.html" }
  ]
}
